# The TrenchyTools API. Get a key with one call (no account):  curl "https://api.trenchy.tools/api/create-api-key?label=wallet-mover"
TRENCHY_API_URL=https://api.trenchy.tools
TRENCHY_API_KEY=

# Where your wallet files live. Leave empty for ./wallets inside this repo (git-ignored). Set the same folder in every starter to share wallets.
# The pump.fun and pons starters read the same folder: a wallet made here is usable there at once.
WALLET_BACKUP_DIR=

PORT=3000
