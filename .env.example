# The TrenchyTools API. Get a key with one call (no account):  curl "https://api.trenchytools.lol/api/create-api-key?label=wallet-mover"
TRENCHY_API_URL=https://api.trenchytools.lol
TRENCHY_API_KEY=

# Where your wallet files live. Leave empty for ~/Desktop/trenchytools-wallets (or ~/trenchytools-wallets without a Desktop).
# The pump.fun and pons starters read the same folder: a wallet made here is usable there at once.
WALLET_BACKUP_DIR=

PORT=3000
